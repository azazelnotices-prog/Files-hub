<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AzHub Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0d0f17; color: #ffffff; font-family: sans-serif; }
        .glass-card { background: rgba(22, 27, 46, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); }
    </style>
</head>
<body class="min-h-screen p-4 max-w-2xl mx-auto">

    <div class="flex items-center justify-between my-6">
        <h1 class="text-xl font-bold text-amber-400"><i class="fa-solid fa-user-shield mr-2"></i>ระบบหลังบ้าน AzHub</h1>
        <a href="/" class="text-xs text-slate-400 hover:text-white bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">กลับหน้าหลัก</a>
    </div>

    <!-- ฟอร์มเพิ่มรายการ -->
    <div class="glass-card rounded-2xl p-5 mb-6 border-amber-500/30">
        <h2 class="text-sm font-bold text-slate-200 mb-3">เพิ่มไฟล์ / เพลงใหม่</h2>
        <form id="addFileForm" class="space-y-3">
            <input type="text" id="fileTitle" placeholder="ชื่อไฟล์ / ชื่อเพลง *" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500">
            <input type="text" id="fileCategory" placeholder="หมวดหมู่ (เช่น Remix, Sound, Mod)" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500">
            <input type="url" id="downloadUrl" placeholder="ลิงก์ดาวน์โหลด (Google Drive / Mega) *" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500">
            <input type="url" id="audioUrl" placeholder="ลิงก์ไฟล์เสียงตัวอย่าง (ถ้ามี)" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500">
            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2.5 rounded-xl text-sm transition">บันทึกรายการ</button>
        </form>
    </div>

    <!-- รายการจัดการลบไฟล์ -->
    <h2 class="text-sm font-bold text-slate-300 mb-3">รายการทั้งหมดในระบบ</h2>
    <div id="adminFileList" class="space-y-3">
        <div class="text-center py-8 text-slate-500 text-sm">กำลังโหลด...</div>
    </div>

    <script>
        async function loadAdminFiles() {
            const listEl = document.getElementById('adminFileList');
            try {
                const res = await fetch('/api/files');
                const files = await res.json();
                if (files.length === 0) {
                    listEl.innerHTML = `<div class="text-center py-6 text-slate-500 text-sm">ยังไม่มีข้อมูล</div>`;
                    return;
                }
                listEl.innerHTML = files.map(file => `
                    <div class="glass-card rounded-xl p-3 flex items-center justify-between gap-3">
                        <div class="overflow-hidden">
                            <p class="font-semibold text-xs text-slate-200 truncate">${file.title}</p>
                            <span class="text-[10px] text-slate-400">${file.category || 'General'}</span>
                        </div>
                        <button onclick="deleteFile('${file.id}')" class="bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs px-3 py-1.5 rounded-lg border border-red-500/30 transition">ลบ</button>
                    </div>
                `).join('');
            } catch (err) {
                listEl.innerHTML = `<div class="text-center py-6 text-red-400 text-sm">โหลดรายการไม่สำเร็จ</div>`;
            }
        }

        document.getElementById('addFileForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const password = prompt('กรุณากรอกรหัสผ่าน Admin:');
            if (!password) return;

            const data = {
                title: document.getElementById('fileTitle').value,
                category: document.getElementById('fileCategory').value,
                downloadUrl: document.getElementById('downloadUrl').value,
                audioUrl: document.getElementById('audioUrl').value,
                password
            };

            const res = await fetch('/api/files', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                alert('เพิ่มรายการสำเร็จ!');
                e.target.reset();
                loadAdminFiles();
            } else {
                alert('รหัสผ่านไม่ถูกต้อง หรือเกิดข้อผิดพลาด');
            }
        });

        async function deleteFile(id) {
            const password = prompt('กรุณากรอกรหัสผ่าน Admin เพื่อยืนยันการลบ:');
            if (!password) return;

            const res = await fetch('/api/files', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, password })
            });

            if (res.ok) {
                loadAdminFiles();
            } else {
                alert('รหัสผ่านไม่ถูกต้อง');
            }
        }

        loadAdminFiles();
    </script>
</body>
</html>
